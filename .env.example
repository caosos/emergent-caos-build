# CAOS / CAOS Care prototype deployment scaffold environment.
# Copy to `.env` and replace placeholders before running Docker Compose.
# Do not commit real secrets.

# Compose/local deployment knobs
COMPOSE_PROJECT_NAME=caos-prototype
CAOS_PROTOTYPE_WEB_PORT=8080

# Backend database
MONGO_URL=mongodb://caos-prototype-mongo:27017
DB_NAME=caos_prototype
CORS_ORIGINS=*

# Existing Emergent prototype runtime key (known migration blocker; placeholder only)
EMERGENT_LLM_KEY=replace-with-emergent-prototype-key-if-still-needed

# Direct OpenAI voice path (optional; placeholder only)
OPENAI_API_KEY=replace-with-openai-key-if-enabled

# Agent swarm / GitHub tooling (optional; placeholders only)
E2B_API_KEY=replace-with-e2b-key-if-enabled
GITHUB_TOKEN=replace-with-github-token-if-enabled

# Google connector OAuth (optional; placeholders only)
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Connector token encryption.
# Generate a Fernet key before using connector OAuth flows.
CONNECTOR_TOKEN_FERNET_KEY=replace-with-fernet-key

# Billing / email integrations (optional; placeholders only)
STRIPE_API_KEY=replace-with-stripe-key-if-enabled
RESEND_API_KEY=replace-with-resend-key-if-enabled
SENDER_EMAIL=CAOS Prototype <onboarding@example.invalid>
CARE_ADMIN_EMAIL=admin@example.invalid

# Auth compatibility flag for the existing prototype.
AUTH_ENFORCED=true

# Chat/runtime tuning (optional)
CAOS_CHAT_TEMPERATURE=0.7

# Memory extractor overrides (optional)
MEMORY_EXTRACTOR_PROVIDER=gemini
MEMORY_EXTRACTOR_MODEL=gemini-3-flash-preview

# Frontend build/runtime notes:
# - The Docker scaffold serves the frontend and proxies /api same-origin via nginx.
# - For standalone frontend development, set this to the backend origin, e.g. http://localhost:8000.
REACT_APP_BACKEND_URL=
ENABLE_HEALTH_CHECK=false
NODE_ENV=production
